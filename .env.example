# Copy to .env.local for local dev (vercel dev / npm run db:migrate), and set
# the same names as Environment Variables on the Vercel project for deploys.

# Supabase Postgres connection string. Use the pooled connection (port 6543,
# "Transaction" mode) from Supabase Dashboard -> Project Settings -> Database
# -> Connection string -> "Transaction pooler". Direct connection (5432) also
# works but isn't recommended for a serverless deployment.
DATABASE_URL="postgres://postgres.xxxxxxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# Supabase project URL and service_role key (Project Settings -> API).
# The service_role key is used server-side only (Supabase Storage uploads) —
# never expose it to the client.
SUPABASE_URL="https://xxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Storage bucket name for uploaded candidate documents. Create this as a
# PRIVATE bucket in Supabase Dashboard -> Storage before first use.
SUPABASE_STORAGE_BUCKET="uploads"

# Random secret used to sign the session cookie. Generate with:
#   openssl rand -hex 32
SESSION_SECRET="replace-with-a-random-64-char-hex-string"

# One-time bootstrap secret (see README "Auth & access control"). Only needed
# until every officer has a password; can be removed/rotated after that.
#   openssl rand -hex 24
AUTH_BOOTSTRAP_SECRET="replace-with-a-random-secret"
