{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:client": "vite build --config vite.client.config.ts",
    "build": "npm run build:client && vite build",
    "preview": "wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply webapp-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply webapp-production"
  },
  "dependencies": {
    "hono": "^4.12.33",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
