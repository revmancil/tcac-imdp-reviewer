{
  "name": "webapp",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vercel dev",
    "build:client": "vite build --config vite.client.config.ts",
    "build:api": "esbuild server/vercel-app.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=api/handler.js",
    "build": "npm run build:client && npm run build:api",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
    "db:backfill-school": "node --experimental-strip-types scripts/backfill-school.mjs",
    "db:backfill-needs-verification": "node scripts/backfill-needs-verification.mjs",
    "deploy": "npm run build && vercel deploy --prod"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "hono": "^4.12.33",
    "mupdf": "^1.28.1",
    "postgres": "^3.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "dotenv": "^16.4.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3",
    "vercel": "^37.14.0",
    "vite": "^8.1.4"
  }
}
