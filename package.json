{
  "name": "webapp",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vercel dev",
    "build:client": "vite build --config vite.client.config.ts",
    "build": "npm run build:client",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
    "deploy": "npm run build && vercel deploy --prod"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "hono": "^4.12.33",
    "postgres": "^3.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.3",
    "vercel": "^37.14.0",
    "vite": "^8.1.4"
  }
}
